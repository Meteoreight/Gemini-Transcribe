{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "moduleResolution": "node"
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/providers/**/*"
  ],
  "exclude": [
    "src/renderer/**/*"
  ]
}